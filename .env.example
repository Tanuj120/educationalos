# Copy this file to .env and keep the real values private.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.8-flash
EMBEDDING_RETRY_AFTER_SECONDS=300
YOUTUBE_API_KEY=your_api_key_here
YOUTUBE_CACHE_TTL_SECONDS=900
GOOGLE_MEET_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
MAX_PDF_UPLOAD_BYTES=26214400
MAX_VIDEO_UPLOAD_BYTES=262144000
MAX_FILES_PER_UPLOAD=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AI_REQUESTS=20
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_WRITE_REQUESTS=60
LOG_LEVEL=INFO
