DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nexus
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
UPLOAD_DIR=./uploads
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_PDF_UPLOAD_BYTES=26214400
MAX_BOOK_UPLOAD_BYTES=104857600
MAX_VIDEO_UPLOAD_BYTES=262144000
MAX_FILES_PER_UPLOAD=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AI_REQUESTS=20
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_WRITE_REQUESTS=60
LOG_LEVEL=INFO
